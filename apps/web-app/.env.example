# Google Workspace Corporate SSO Configuration
# Obtain your OAuth 2.0 Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Ensure Authorized JavaScript Origins include your local dev URL (e.g., http://localhost:5173)
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# Restrict SSO logins to specific email domains (comma-separated, optional)
VITE_ALLOWED_EMAIL_DOMAINS="camp1.tkxel.com,tkxel.com"

# Default Vault Administrator email addresses (comma-separated)
VITE_VAULT_OWNER_EMAIL="mubashir.ali@camp1.tkxel.com"
