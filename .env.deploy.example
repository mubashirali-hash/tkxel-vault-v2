# Copy to .env on the deployment host. Do not commit the resulting file.
# Use your cloud secret manager or CI/CD secret injection for production.

# Image naming: local use is the default; set a registry path when pulling
# images built elsewhere, for example ghcr.io/<owner>/tkxel-vault.
IMAGE_PREFIX=tkxel-vault
IMAGE_TAG=latest

POSTGRES_PASSWORD=replace-with-a-long-random-database-password
RUNNER_SHARED_SECRET=replace-with-a-random-32-plus-character-secret
SSO_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Choose exactly one KMS configuration. Azure shown here as an example.
KMS_PROVIDER=azure
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
AZURE_KEY_VAULT_KEY_NAME=tkxel-vault-master
AZURE_KEY_VAULT_BEARER_TOKEN=inject-a-short-lived-workload-token
AWS_KMS_KEY_ID=
AWS_REGION=

# Hosted providers for production. Locked-vault content must never be embedded.
ANTHROPIC_API_KEY=inject-from-secret-manager
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=inject-from-secret-manager
OPENAI_BASE_URL=https://api.openai.com/v1
